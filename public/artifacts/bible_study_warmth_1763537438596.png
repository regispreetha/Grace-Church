<svg width="1200" height="800" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0d9488;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1a365d;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="1200" height="800" fill="url(#grad2)"/>
  <g transform="translate(600, 350)">
    <rect x="-100" y="-120" width="200" height="160" rx="10" fill="#d4af37" opacity="0.3"/>
    <rect x="-80" y="-100" width="160" height="120" rx="5" fill="none" stroke="#d4af37" stroke-width="3"/>
    <line x1="-60" y1="-80" x2="60" y2="-80" stroke="#d4af37" stroke-width="2"/>
    <line x1="-60" y1="-50" x2="60" y2="-50" stroke="#d4af37" stroke-width="2"/>
    <line x1="-60" y1="-20" x2="60" y2="-20" stroke="#d4af37" stroke-width="2"/>
  </g>
  <text x="600" y="550" font-family="Arial, sans-serif" font-size="48" fill="#d4af37" text-anchor="middle" font-weight="bold">Bible Study</text>
  <text x="600" y="600" font-family="Arial, sans-serif" font-size="24" fill="#ffffff" text-anchor="middle">Growing Together in God's Word</text>
</svg>
